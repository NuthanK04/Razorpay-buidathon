# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Default: Local SQLite database for seamless out-of-the-box local setup)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & Merchant Auth
JWT_SECRET="agentcart_super_secure_jwt_secret_2026"

# Razorpay Test Mode Credentials
# Get your free test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_buildathon2026"
RAZORPAY_KEY_SECRET="agentcart_razorpay_secret_key_demo"

# AI Provider API Keys (Optional - Intelligent Deterministic Engine runs automatically if omitted)
GEMINI_API_KEY=""
